# Copia este archivo a .env y completa los valores reales.
# Nunca subas el archivo .env al control de versiones.

DJANGO_SETTINGS_MODULE=config.settings.desarrollo
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-generada-de-forma-segura
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=True

DB_NAME=aviste
DB_USER=aviste
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
