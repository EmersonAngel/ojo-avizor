# Copia este archivo a .env y completa los valores reales.
# Nunca subas el archivo .env al control de versiones.

DJANGO_SETTINGS_MODULE=config.settings.desarrollo
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-generada-de-forma-segura
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=True

DB_NAME=ojo_avizor
DB_USER=ojo_avizor
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Inicio de sesión con Google (opcional): sin esto, el botón "Continuar con
# Google" existe pero falla al usarse — el resto del sitio funciona igual.
# Se consiguen en https://console.cloud.google.com/ → "APIs y servicios" →
# "Credenciales" → "Crear credenciales" → "ID de cliente de OAuth" → tipo
# "Aplicación web". Como URI de redirección autorizado, registra:
#   http://localhost:8000/accounts/google/login/callback/   (desarrollo)
#   https://tu-dominio.com/accounts/google/login/callback/  (producción)
# Ver la sección "Inicio de sesión con Google" del README.md para la guía completa.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
