# Copia este archivo a .env y completa los valores reales.
# Nunca subas el archivo .env al control de versiones.

DJANGO_SETTINGS_MODULE=config.settings.desarrollo
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-generada-de-forma-segura
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=True

DB_NAME=ojo_avizor
DB_USER=ojo_avizor
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Solo hace falta en el despliegue gratuito con Neon (README.md, "Despliegue
# gratuito"), que exige TLS para conectarse: DB_SSLMODE=require. En
# desarrollo y en el despliegue con Docker/VPS, se deja vacío.
DB_SSLMODE=

# Correo saliente (solo aplica en producción — en desarrollo el correo se
# imprime en la consola y estas variables se ignoran). Sin esto configurado,
# las notificaciones y la recuperación de contraseña fallan en silencio.
# Con Gmail: activa la verificación en dos pasos en la cuenta remitente y
# genera una "contraseña de aplicación" en https://myaccount.google.com/apppasswords
# — no funciona con la contraseña normal de la cuenta.
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
# Remitente que ven los usuarios. Usa un correo real del dominio del
# proyecto si existe uno; si no, el correo de la cuenta configurada arriba
# (DJANGO_EMAIL_HOST_USER) funciona igual de bien como remitente.
DJANGO_DEFAULT_FROM_EMAIL=Ojo Avizor <no-responder@ojoavizor.local>

# Inicio de sesión con Google (opcional): sin esto, el botón "Continuar con
# Google" existe pero falla al usarse — el resto del sitio funciona igual.
# Se consiguen en https://console.cloud.google.com/ → "APIs y servicios" →
# "Credenciales" → "Crear credenciales" → "ID de cliente de OAuth" → tipo
# "Aplicación web". Como URI de redirección autorizado, registra:
#   http://localhost:8000/accounts/google/login/callback/   (desarrollo)
#   https://tu-dominio.com/accounts/google/login/callback/  (producción)
# Ver la sección "Inicio de sesión con Google" del README.md para la guía completa.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backblaze B2 (solo hace falta en el despliegue gratuito, README.md,
# "Despliegue gratuito"): sin esto, las fotos de avistamientos se guardan
# en el disco del contenedor, y Render no tiene disco persistente — se
# perderían en el próximo reinicio o despliegue. En el despliegue con
# Docker/VPS se deja todo esto vacío a propósito (usa disco local).
# El bucket se crea Privado (no Público: Backblaze pide tarjeta para
# verificar la cuenta si se hace público) — Django arma una URL firmada
# distinta cada vez que muestra una foto, no hace falta ningún dominio
# público del bucket.
B2_BUCKET_NAME=
B2_ENDPOINT_URL=
B2_REGION=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
